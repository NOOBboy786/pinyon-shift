+TEST_CASE("XmaContext GetPacketNumber boundary handling", "[audio][xma]") {
+  constexpr size_t kBufferSize = 2 * XmaContext::kBytesPerPacket; // 2 packets
+
+  // Less than packet header
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, 0) == -1);
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, XmaContext::kBitsPerPacketHeader - 1) == -1);
+
+  // Exact packet header of packet 0
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, XmaContext::kBitsPerPacketHeader) == 0);
+
+  // Mid-packet 0
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, XmaContext::kBitsPerPacket / 2) == 0);
+
+  // Start of packet 1
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, XmaContext::kBitsPerPacket) == 1);
+
+  // End of packet 1 boundary
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, (kBufferSize << 3) - 1) == 1);
+
+  // At or beyond buffer size (exhausted)
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, kBufferSize << 3) == -1);
+  CHECK(XmaContext::GetPacketNumber(kBufferSize, (kBufferSize << 3) + 100) == -1);
+}
