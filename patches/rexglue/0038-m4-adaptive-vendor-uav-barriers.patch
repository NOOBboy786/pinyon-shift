diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 2916251..bb34190 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -60,6 +60,8 @@ namespace shaders {
 #include "../shaders/bytecode/d3d12_5_1/resolve_downscale_cs.h"
 }  // namespace shaders
 
+static uint32_t s_submission_draw_counter = 0;
+static uint32_t s_submission_index_counter = 0;
+
 D3D12CommandProcessor::D3D12CommandProcessor(D3D12GraphicsSystem* graphics_system,
                                              system::KernelState* kernel_state)
     : CommandProcessor(graphics_system, kernel_state), deferred_command_list_(*this) {
@@ -2721,8 +2723,23 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
       if (memexport_total_size != 0) {
         PROFILE_MEMEXPORT_BYTES(memexport_total_size);
         if (REXCVAR_GET(readback_memexport_fast)) {
+          const auto vendor_id = static_cast<uint32_t>(GetD3D12Provider().GetAdapterVendorID());
+          if (vendor_id == 0x1002 /* AMD */ || vendor_id == 0x8086 /* Intel */) {
+            // Insert D3D12_RESOURCE_BARRIER_TYPE_UAV on GetSharedMemoryResource() buffer.
+            PushUAVBarrier(shared_memory_->GetBuffer());
+            SubmitBarriers();
+          }
           IssueDraw_MemexportReadbackFastPath(memexport_total_size);
         } else {
           IssueDraw_MemexportReadbackFullPath(memexport_total_size);
         }
       }
     }
   }
+
+  // Throttle command list size for AMD APUs and general hardware stability.
+  // Chunking draw calls and index counts prevents any single command list from exceeding the Windows TDR watchdog.
+  // Non-blocking submission: do NOT synchronously wait on fences mid-frame to prevent CPU-GPU deadlocks.
+  s_submission_draw_counter++;
+  s_submission_index_counter += index_count;
+  if (s_submission_draw_counter >= 512 || s_submission_index_counter >= 32768 || index_count >= 12000) {
+    if (submission_open_ && !scratch_buffer_used_) {
+      s_submission_draw_counter = 0;
+      s_submission_index_counter = 0;
+      EndSubmission(false);
+    }
+  }
+
   return true;
 }
@@ -3400,6 +3425,8 @@ bool D3D12CommandProcessor::EndSubmission(bool is_swap) {
   }
 
   if (submission_open_) {
+    s_submission_draw_counter = 0;
+    s_submission_index_counter = 0;
     assert_false(scratch_buffer_used_);
 
     if (active_occlusion_query_.valid && occlusion_query_heap_) {
@@ -3497,7 +3523,7 @@ bool D3D12CommandProcessor::EndSubmission(bool is_swap) {
 }
 
 bool D3D12CommandProcessor::CanEndSubmissionImmediately() const {
-  return !submission_open_ || !pipeline_cache_->IsCreatingPipelines();
+  return !submission_open_ || (!scratch_buffer_used_ && !pipeline_cache_->IsCreatingPipelines());
 }
 
